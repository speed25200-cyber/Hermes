"use strict";
const fs = require("fs");
const path = require("path");

let cfg = { dataDir:"", startEq:400, tsISO: ()=>new Date().toISOString(), log: ()=>{} };
let state = { start:0, equity:0, realized:0, updatedAt:null };
let paths = {};

function ensureDir(p){ try{ fs.mkdirSync(p,{recursive:true}); }catch{} }

function initSimEquity(opts){
  cfg = { ...cfg, ...opts };
  paths.account   = path.join(cfg.dataDir, "sim-account.json");
  paths.equityLog = path.join(cfg.dataDir, "sim-equity.jsonl");
  ensureDir(path.dirname(paths.account));
  // charge ou initialise
  try { const s = JSON.parse(fs.readFileSync(paths.account,"utf8")); state = { ...state, ...s }; } catch {}
  if (!Number.isFinite(state.start))    state.start    = Number(cfg.startEq)||400;
  if (!Number.isFinite(state.equity))   state.equity   = state.start;
  if (!Number.isFinite(state.realized)) state.realized = 0;
  save();
  // seed log s'il est vide
  try {
    const needSeed = (!fs.existsSync(paths.equityLog)) || (fs.statSync(paths.equityLog).size === 0);
    if (needSeed) appendEquity(null);
  } catch {}
}

function save(){ state.updatedAt = cfg.tsISO(); fs.writeFileSync(paths.account, JSON.stringify(state,null,2)); }

function appendEquity(trade){
  const line = {
    ts: cfg.tsISO(),
    equity: +state.equity.toFixed(8),
    realized: +state.realized.toFixed(8),
    trade: trade ? { instId: trade.instId, pnl: +Number(trade.pnl||0) } : null
  };
  fs.appendFileSync(paths.equityLog, JSON.stringify(line)+"\n");
}

function onTradeExit(o){
  const pnl = Number(o.pnl || 0);
  state.realized += pnl;
  state.equity   += pnl;
  save();
  appendEquity(o);
}

function countTradesSince(msAgo){
  const since = Date.now() - msAgo;
  let count = 0;
  try {
    if (!fs.existsSync(paths.equityLog)) return 0;
    const lines = fs.readFileSync(paths.equityLog, "utf8").trim().split("\n");
    for (let i = lines.length - 1; i >= 0; i--){
      const ln = lines[i]; if (!ln) continue;
      try {
        const o = JSON.parse(ln);
        const t = +new Date(o.ts||0);
        if (!t || t < since) break;       // on peut s'arrêter
        if (o.trade && Number.isFinite(o.trade.pnl)) count++;
      } catch {}
    }
  } catch {}
  return count;
}

function format3m(){
  const win = Number(process.env.HERMES_SIM_EQ_WINDOW_MS || 180000);
  const trades3m = countTradesSince(win);          // N dans les 3m
  const pnlCum   = state.realized;                 // cumul depuis départ (ça s'additionne)
  const sign     = pnlCum >= 0 ? "+" : "";
  return [AI-SIM] Trades (3m)  | PnL :  USDT | Equity :  USDT;
}

function startTicker(broadcast, periodMs){const every = Number(periodMs || process.env.HERMES_SIM_EQ_EVERY_MS || 180000);
  
  try{
    const text = format3m();
    broadcast({ ts: cfg.tsISO(), event:"INFO", info:text, live:false, _fmt:"SIM_EQ_3M" });
  }catch(e){ try{ cfg.log("[SIM_EQ:tickerOnce]", e.message) }catch{} }
  setInterval(()=>{
    try{
      const text = format3m();
      broadcast({ ts: cfg.tsISO(), event:"INFO", info:text, live:false, _fmt:"SIM_EQ_3M" });
    }catch(e){ try{ cfg.log("[SIM_EQ:ticker]", e.message) }catch{} }
  }, every);
}

module.exports = { initSimEquity, onTradeExit, startTicker, format3m, state, paths };

