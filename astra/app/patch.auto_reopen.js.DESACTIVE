/* [HERMES_PATCH_AUTOREOPEN] */
const MAX_POS = Number(process.env.MAX_POSITIONS_GLOBAL||10);
let _autoTimer = null;

async function ensurePositionsLoop(ctx){
  const { getOpenPositionsCount, tryOpenNext } = ctx || {};
  if (typeof getOpenPositionsCount !== "function" || typeof tryOpenNext !== "function"){
    console.warn("[AUTO] fonctions manquantes (getOpenPositionsCount/tryOpenNext) — inactif.");
    return;
  }
  if (_autoTimer) return;
  _autoTimer = setInterval(async ()=>{
    try{
      const n = await getOpenPositionsCount();
      if (n < MAX_POS){
        await tryOpenNext();
      }
    }catch(e){ console.error("[AUTO] loop error:", e&&e.message||e); }
  }, 2000);
}

function hookOnPositionClosed(bus, ctx){
  try{
    if (bus && typeof bus.on === "function"){
      bus.on("position-closed", async ()=>{
        try{
          await ensurePositionsLoop(ctx);
          if (typeof ctx.tryOpenNext === "function"){ await ctx.tryOpenNext(); }
        }catch(e){ console.error("[AUTO] on close", e&&e.message||e); }
      });
    }
  }catch(e){ console.error("[AUTO] hook error", e&&e.message||e); }
}

module.exports = { ensurePositionsLoop, hookOnPositionClosed };
