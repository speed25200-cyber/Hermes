# Jamais dans le depot : larchive dorigine portait TROIS fichiers
# denvironnement avec de vraies cles OKX de production, et ils sont
# partis dans un commit pousse sur un depot prive avant detre retires.
.env
.env.*
!.env.example

# Dependances : se reinstallent depuis package.json
node_modules/

# Donnees et traces : ce nest pas du code, et cest volumineux
/data/
/logs/
/state/
*.log
*.jsonl

# Etat dexecution : ces deux fichiers sont ecrits par le moteur en
# marche. Versionnes, ils entrent en conflit a chaque deploiement.
/runtime/*.json

config.local.json

# Ecrit par le chercheur de perles SUR la machine ; le deployer depuis
# le depot ecraserait le verdict le plus recent par un vieux.
/config/roster.json
# Roster live promu sur la machine avec sa preuve; jamais remplace par rsync.
/config/approved-roster.json
# Cle publique de promotion propre au deploiement (la cle privee reste en CI).
/config/evidence-public-key.pem
/config/monitoring-public-key.pem
# Autorites quantitatives publiques propres au deploiement/offline. Les cles
# privees restent exclusivement chez les jobs d'attestation independants.
/config/quant-execution-attestation-public-key.pem
/config/quant-cycle-ledger-attestation-public-key.pem
