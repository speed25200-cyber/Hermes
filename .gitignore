# Jamais dans le depot : larchive dorigine portait TROIS fichiers
# denvironnement avec de vraies cles OKX de production, et ils sont
# partis dans un commit pousse sur un depot public avant detre retires.
.env
.env.*
!.env.example

# Dependances : se reinstallent depuis package.json
node_modules/

# Donnees et traces : ce nest pas du code, et cest volumineux
/data/
/logs/
/state/
*.log
*.jsonl

# Etat dexecution : ces deux fichiers sont ecrits par le moteur en
# marche. Versionnes, ils entrent en conflit a chaque deploiement.
/runtime/*.json

config.local.json

# Ecrit par le chercheur de perles SUR la machine ; le deployer depuis
# le depot ecraserait le verdict le plus recent par un vieux.
/config/roster.json

# Bytecode Python : le moteur Python a ete retire le 31 aout, et ses
# caches compiles etaient restes suivis — 85 fichiers qui ne faisaient
# partie d aucune version.
__pycache__/
*.pyc

# Ecrit par le banc Jev SUR la machine (deploy/banc_jev_1m.js) : c'est la
# porte du reel, et elle vaut pour une machine, une fenetre et une
# signature de questions. Le deployer depuis le depot autoriserait le reel
# avec un verdict d'ailleurs.
/config/jev_verdict.json
